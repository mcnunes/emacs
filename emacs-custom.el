(custom-set-variables
 ;; custom-set-variables was added by Custom.
 ;; If you edit it by hand, you could mess it up, so be careful.
 ;; Your init file should contain only one such instance.
 ;; If there is more than one, they won't work right.
 '(auth-source-save-behavior nil)
 '(column-number-mode t)
 '(display-line-numbers-type 'relative)
 '(display-time-mode t)
 '(doc-view-continuous t)
 '(global-display-line-numbers-mode t)
 '(package-selected-packages
   '(ace-jump-mode alert ansible ansible-doc cape corfu corfu-prescient csv-mode
		   gptel markdown-mode orderless yaml-mode))
 '(tool-bar-mode nil))
(custom-set-faces
 ;; custom-set-faces was added by Custom.
 ;; If you edit it by hand, you could mess it up, so be careful.
 ;; Your init file should contain only one such instance.
 ;; If there is more than one, they won't work right.
 '(default ((t (:family "AdwaitaMono Nerd Font Mono" :foundry "UKWN" :slant normal :weight regular :height 113 :width normal))))
 '(cursor ((t (:background "#cccccc"))))
 '(mode-line ((t (:background "#323232" :foreground "gray90" :box nil))))
 '(mode-line-inactive ((t (:inherit mode-line :background "#323232" :foreground "grey50" :box nil :weight light))))
 '(show-paren-match ((t (:foreground "SteelBlue1" :weight bold))))
 '(tab-bar ((t (:inherit mode-line))))
 '(tab-bar-separator ((t (:foreground "black" :weight light))))
 '(tab-bar-tab ((t (:inherit mode-line :box nil :bold t))))
 '(tab-bar-tab-inactive ((t (:inherit mode-line-inactive :box nil)))))

